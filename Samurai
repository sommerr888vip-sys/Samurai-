local function moveStep(dt)
local h,r=hum(),root()
if not(h and r)then return end
if S.speedOn then h.WalkSpeed=S.speed end
if S.jumpOn then h.UseJumpPower=true;h.JumpPower=S.jump end
if S.fly then
if not flyBV or flyBV.Parent~=r then setFly(true)end
local v=h.MoveDirection*S.flySpeed*4
if UIS:IsKeyDown(Enum.KeyCode.Space)then v+=Vector3 .new(0,S.flySpeed*4,0)end
if UIS:IsKeyDown(Enum.KeyCode.LeftControl)then v-=Vector3 .new(0,S.flySpeed*4,0)end
if h.MoveDirection.Magnitude>0 then v+=Vector3 .new(0,Cam.CFrame.LookVector.Y*S.flySpeed*4,0)end
if flyBV then flyBV.Velocity=v end
local target
if v.Magnitude>4 then
local up=v.Unit
local front=Vector3 .new(0,-1,0)-up*(-up.Y)
if front.Magnitude<0.1 then front=Cam.CFrame.LookVector-up*Cam.CFrame.LookVector:Dot(up)end
if front.Magnitude>0.05 then
front=front.Unit
local back=-front
target=CFrame.fromMatrix(r.Position,up:Cross(back),up,back)
end
else
local lv=Cam.CFrame.LookVector
target=CFrame.lookAt(r.Position,r.Position+Vector3 .new(lv.X,0,lv.Z))
end
if target then r.CFrame=r.CFrame:Lerp(target,math.clamp(dt*10,0,1))end
end
if S.spin then
r.CFrame*=CFrame.Angles(0,math.rad(320)*dt,0)
end
end
