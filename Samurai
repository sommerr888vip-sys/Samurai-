elseif r.accepted then col=Color3 .fromRGB(120,230,140);mark=""
else col=Color3 .fromRGB(240,210,90);mark=""end
pushLog(string.format("#%d [%s] %s → %s\n%.1f st | преграда: %s\nсервер: %s | античит: %s%s",
counter+1,r.time,r.kind,r.target,r.dist,r.obstructed and"ДА"or"нет",verdict,
r.flagged and"СРАБОТАЛ"or"нет",mark),col)
end
local function candidates()
local list={}
local function add(model)
local h=model:FindFirstChildOfClass("Humanoid")
local head=model:FindFirstChild("Head")
if h and head and h.Health>0 then table.insert(list,{model=model,part=head})end
end
for _,p in ipairs(Players:GetPlayers())do if p~=LP and p.Character then add(p.Character)end end
local tf=Workspace:FindFirstChild("ACTargets")
if tf then for _,m in ipairs(tf:GetChildren())do if m:IsA("Model")then add(m)end end end
return list
end
local function farthest(list)
local best,bd
for _,c in ipairs(list)do
local d=(c.part.Position-Cam.CFrame.Position).Magnitude
if not bd or d>bd then best,bd=c,d end
end
return best
end
local lastSwitch,switchIdx=0,0
local function pick()
local list=candidates()
if#list==0 then return nil end
if S.acFastSwitch then
if os.clock()-lastSwitch>=math.max(S.acDelay,80)/1000 then
lastSwitch=os.clock();switchIdx=switchIdx%#list+1
end
return list[math.min(switchIdx,#list)]
end
local pool=list
if S.acWallShot then
local blocked={}
for _,c in ipairs(list)do if not hasLOS(c.part)then table.insert(blocked,c)end end
if#blocked>0 then pool=blocked end
end
local center,rad=Cam.ViewportSize/2,fovRadius(S.acFov)
local best,bestScore
for _,c in ipairs(pool)do
if S.acThrough or S.acWallShot or hasLOS(c.part)then
local sp,vis=Cam:WorldToViewportPoint(c.part.Position)
local d2=(Vector2 .new(sp.X,sp.Y)-center).Magnitude
local wd=(c.part.Position-Cam.CFrame.Position).Magnitude
if S.acAuto or(vis and d2<=rad)then
local score=S.acAuto and wd or d2
if not bestScore or score<bestScore then best,bestScore=c,score end
end
end
end
return best
end
local inflight=0
local function fire(cur,kind)
if not cur or not cur.part.Parent or inflight>=4 then return end
local origin,hitPos=Cam.CFrame.Position,cur.part.Position
if kind=="bad_hitpos"then
hitPos=hitPos+Vector3 .new(math.random(30,60),math.random(0,20),math.random(30,60))
elseif kind=="spoof_origin"then
origin=origin+Vector3 .new(0,0,120)
end
inflight+=1
task.spawn(function()
local ok2,r=pcall(function()
return hitRF:InvokeServer(cur.model,hitPos,origin,Cam.CFrame.LookVector,kind)
end)
inflight-=1
if ok2 and type(r)=="table"and not r.error then
addLog(r,kind~="normal")
if r.accepted then fxHitEffect(cur.part,r.hitPos)end
else
pushLog("[ошибка] "..kind..": "..tostring(ok2 and r and r.error or r),Color3 .fromRGB(200,200,210))
end
end)
end
local function currentKind(cur)
if S.acImpossible then
local ks={"bad_hitpos","spoof_origin","far_range"}
return ks[math.random(#ks)]
end
if S.acWallShot and not hasLOS(cur.part)then return"wall_shot"end
if S.acFastSwitch then return"fast_switch"end
if S.acHard then return"hard_aim"end
return"normal"
end
local lastSnap,lastFire=0,0
RunService:BindToRenderStep("SamuraiACTest",Enum.RenderPriority.Camera.Value+3,function()
if not S.acTest then acTargetPart=nil;return end
local cur=pick()
acTargetPart=cur and cur.part or nil
if not cur then return end
local now=os.clock()
if S.acHard and now-lastSnap>=S.acDelay/1000 then
lastSnap=now
Cam.CFrame=CFrame.lookAt(Cam.CFrame.Position,cur.part.Position)
end
if S.acAutoFire and now-lastFire>=S.acFireMs/1000 then
lastFire=now
local kind=currentKind(cur)
if kind=="far_range"then cur=farthest(candidates())or cur end
fire(cur,kind)
end
end)
local running=false
local function runAll()
if running then return end
running=true
local list=candidates()
if#list==0 then
pushLog("Нет целей: зайди с другом или оставь SPAWN_DUMMIES = true на сервере",Color3 .fromRGB(240,210,90))
running=false;return
end
local vis,blocked={},{}
for _,c in ipairs(list)do table.insert(hasLOS(c.part)and vis or blocked,c)end
local seq={
{"normal",vis[1]or list[1]},{"hard_aim",vis[1]or list[1]},{"wall_shot",blocked[1]or list[1]},
{"bad_hitpos",list[1]},{"spoof_origin",list[1]},{"far_range",farthest(list)},
}
for _,sc in ipairs(seq)do fire(sc[2],sc[1]);task.wait(0.35)end
if#list>=2 then fire(list[1],"fast_switch");task.wait(0.04);fire(list[2],"fast_switch")end
running=false
end
