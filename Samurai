local function espStep(dt)
local any=S.espPlayer or S.espHP or S.espName or S.espDist or S.espSkel or S.espTracer or S.espBar
for _,plr in ipairs(Players:GetPlayers())do
if plr~=LP then
local c=plr.Character
local e=esp[plr]
if e and(e.char~=c or not e.hrp.Parent)then clearESP(plr)e=nil end
if c and not e and any then e=newESP(plr,c)esp[plr]=e end
if e then
local dist=(Cam.CFrame.Position-e.hrp.Position).Magnitude
local alive=isEnemy(plr)and e.hum.Health>0 and dist<=S.espMax
local col=(S.espTeam and plr.Team)and plr.TeamColor.Color or Color3 .fromRGB(255,60,90)
e.hl.Enabled=alive and S.espPlayer
e.hl.FillColor=col;e.hl.OutlineColor=col
for _,bn in ipairs(e.bones)do
local shown=false
if alive and S.espSkel then
local p1,v1=Cam:WorldToViewportPoint(bn.a.Position)
local p2,v2=Cam:WorldToViewportPoint(bn.b.Position)
if v1 and v2 then
drawLine(bn.f,Vector2 .new(p1 .X,p1 .Y),Vector2 .new(p2 .X,p2 .Y))
bn.f.BackgroundColor3=col
shown=true
end
end
if not shown then bn.f.Visible=false end
end
local showBB=alive and(S.espHP or S.espName or S.espDist)
e.bb.Enabled=showBB
if showBB then
local t={}
if S.espName then table.insert(t,plr.DisplayName)end
if S.espDist then table.insert(t,math.floor(dist).."m")end
if S.espHP then table.insert(t,math.floor(e.hum.Health).." HP")end
e.txt.Text=table.concat(t," | ")
e.barBg.Visible=S.espHP
local r=math.clamp(e.hum.Health/math.max(e.hum.MaxHealth,1),0,1)
e.fill.Size=UDim2 .fromScale(r,1)
e.fill.BackgroundColor3=Color3 .fromHSV(r*0.33,1,1)
end
local sp=Cam:WorldToViewportPoint(e.hrp.Position)
if alive and S.espTracer and sp.Z>0 then
drawLine(e.line,Vector2 .new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y),Vector2 .new(sp.X,sp.Y))
e.line.BackgroundColor3=col
else
e.line.Visible=false
end
local hpNow=math.clamp(e.hum.Health/math.max(e.hum.MaxHealth,1),0,1)
e.disp+=(hpNow-e.disp)*math.min(1,(dt or 0.016)*8)
local topP=Cam:WorldToViewportPoint(e.hrp.Position+Vector3 .new(0,2.7,0))
local botP=Cam:WorldToViewportPoint(e.hrp.Position-Vector3 .new(0,3,0))
if alive and S.espBar and topP.Z>0 and botP.Z>0 then
local ht=botP.Y-topP.Y
local bx=topP.X-ht*0.32-5
e.hpBg.Visible=true;e.hpFill.Visible=true
e.hpBg.Position=UDim2 .fromOffset(bx-1,topP.Y-1);e.hpBg.Size=UDim2 .fromOffset(4,ht+2)
e.hpFill.Position=UDim2 .fromOffset(bx,botP.Y);e.hpFill.Size=UDim2 .fromOffset(2,math.max(ht*e.disp,1))
local r=e.disp
e.hpFill.BackgroundColor3=r>=0.5
and Color3 .fromRGB(255,220,0):Lerp(Color3 .fromRGB(60,255,90),(r-0.5)*2)
or Color3 .fromRGB(255,40,40):Lerp(Color3 .fromRGB(255,220,0),r*2)
else
e.hpBg.Visible=false;e.hpFill.Visible=false
end
end
end
end
end
