local rayParams=RaycastParams.new()
rayParams.FilterType=Enum.RaycastFilterType.Exclude
local lockedPart
local function validPart(p,rad,center)
local c=p.Character
local h=c and c:FindFirstChildOfClass("Humanoid")
local part=c and(c:FindFirstChild(S.aimPart)or c:FindFirstChild("HumanoidRootPart"))
if not(part and h and h.Health>0)then return end
if S.aimTeam and p.Team~=nil and p.Team==LP.Team then return end
local sp,vis=Cam:WorldToViewportPoint(part.Position)
if not vis then return end
local d=(Vector2 .new(sp.X,sp.Y)-center).Magnitude
if d>rad then return end
if S.aimWall then
rayParams.FilterDescendantsInstances={char(),c}
local o=Cam.CFrame.Position
if Workspace:Raycast(o,part.Position-o,rayParams)then return end
end
return part,d
end
local function aimStep(dt)
circle.Visible=S.aim
if not S.aim then lockedPart=nil return end
local rad=circleRadius()
local center=Cam.ViewportSize/2
circle.Size=UDim2 .fromOffset(rad*2,rad*2)
stroke.Color=rainbow(0.3)
if not(S.aimAlways or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2))then lockedPart=nil return end
local keep
if lockedPart and lockedPart.Parent then
local p=Players:GetPlayerFromCharacter(lockedPart.Parent)
if p then keep=validPart(p,rad,center)end
end
if keep then
lockedPart=keep
else
local best,bestD
for _,p in ipairs(Players:GetPlayers())do
if p~=LP then
local part,d=validPart(p,rad,center)
if part and(not bestD or d<bestD)then best,bestD=part,d end
end
end
lockedPart=best
end
if not lockedPart then return end
local pos=lockedPart.Position
if S.aimPredict then pos+=lockedPart.AssemblyLinearVelocity*0.08 end
local alpha=1-(1-math.clamp(S.aimSmooth,1,100)/100)^(dt*60)
Cam.CFrame=Cam.CFrame:Lerp(CFrame.lookAt(Cam.CFrame.Position,pos),alpha)
end
